{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morrow-needle.invalid/schemas/legal-spatial-state-v0.1.json",
  "title": "Morrow // Needle Legal Spatial State v0.1",
  "description": "Canonical officially operative legal geometry. Owns source-defined spatial extent while referencing causal evidence, governing rules and temporal assertions without absorbing them.",
  "type": "object",
  "required": [
    "schema_version",
    "spatial_state_id",
    "character",
    "legal_character",
    "authority",
    "geometry",
    "causal_input_refs",
    "governing_rule_refs",
    "temporal_assertion_refs",
    "evidence_state",
    "source_refs",
    "guardrails"
  ],
  "properties": {
    "schema_version": {"const": "legal-spatial-state-v0.1"},
    "spatial_state_id": {"type": "string", "minLength": 1},
    "character": {"const": "LEGAL_SPATIAL_STATE"},
    "legal_character": {
      "type": "string",
      "enum": [
        "PROTECTION_ZONE",
        "SURVEILLANCE_ZONE",
        "FISHERY_REAL_TIME_CLOSURE",
        "OTHER_RESTRICTED_AREA"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_id", "label", "authority_type"],
      "properties": {
        "authority_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "authority_type": {
          "type": "string",
          "enum": [
            "EU_INSTITUTION",
            "MEMBER_STATE_AUTHORITY",
            "OTHER_OFFICIAL_AUTHORITY"
          ]
        }
      }
    },
    "geometry": {
      "oneOf": [
        {"$ref": "#/$defs/circle"},
        {"$ref": "#/$defs/polygon"}
      ]
    },
    "causal_input_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/causal_ref"}
    },
    "governing_rule_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source_ref"}
    },
    "temporal_assertion_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_state": {"const": "DIRECT"},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source_ref"}
    },
    "guardrails": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "notes": {"type": ["string", "null"]}
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "source_latitude": {"type": ["string", "null"]},
        "source_longitude": {"type": ["string", "null"]}
      }
    },
    "circle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometry_type",
        "coordinate_reference_system",
        "definition_character",
        "centre",
        "radius"
      ],
      "properties": {
        "geometry_type": {"const": "CIRCLE"},
        "coordinate_reference_system": {"const": "WGS84"},
        "definition_character": {"const": "DIRECT_OFFICIAL_GEOMETRY"},
        "centre": {"$ref": "#/$defs/point"},
        "radius": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "unit"],
          "properties": {
            "value": {"type": "number", "exclusiveMinimum": 0},
            "unit": {"const": "KM"}
          }
        }
      }
    },
    "polygon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometry_type",
        "coordinate_reference_system",
        "definition_character",
        "vertices",
        "closed_ring"
      ],
      "properties": {
        "geometry_type": {"const": "POLYGON"},
        "coordinate_reference_system": {"const": "WGS84"},
        "definition_character": {"const": "DIRECT_OFFICIAL_GEOMETRY"},
        "vertices": {
          "type": "array",
          "minItems": 4,
          "items": {"$ref": "#/$defs/point"}
        },
        "closed_ring": {"const": true}
      }
    },
    "causal_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type",
        "object_id",
        "relation_character",
        "evidence_state"
      ],
      "properties": {
        "object_type": {
          "type": "string",
          "enum": [
            "AUTHORITATIVE_FINDING",
            "AUTHORITATIVE_METRIC_OBSERVATION",
            "OTHER_OFFICIAL_CONTEXT"
          ]
        },
        "object_id": {"type": "string", "minLength": 1},
        "relation_character": {
          "type": "string",
          "enum": [
            "TRIGGERING_FINDING",
            "TRIGGERING_METRIC",
            "CAUSAL_CONTEXT"
          ]
        },
        "evidence_state": {
          "type": "string",
          "enum": ["DIRECT", "DERIVED", "CONTEXTUAL", "UNRESOLVED"]
        },
        "notes": {"type": ["string", "null"]}
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "identifier",
        "locator",
        "role",
        "authority_character"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "EUR_LEX",
            "OFFICIAL_JOURNAL",
            "MEMBER_STATE_OFFICIAL",
            "OTHER_OFFICIAL"
          ]
        },
        "identifier": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "language": {"type": ["string", "null"]},
        "role": {
          "type": "string",
          "enum": [
            "GEOMETRY",
            "GOVERNING_RULE",
            "CAUSAL_CONTEXT",
            "AUTHORITY",
            "CONTEXT"
          ]
        },
        "authority_character": {
          "type": "string",
          "enum": [
            "BINDING_LEGAL_TEXT",
            "AUTHENTIC_OFFICIAL_GEOMETRY",
            "OFFICIAL_CONTEXT"
          ]
        }
      }
    }
  },
  "additionalProperties": false
}
