{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morrow-needle.invalid/schemas/feed-card-v0.1.json",
  "title": "Morrow // Needle Feed Card v0.1",
  "description": "Disposable public/audit projection of an operational result.",
  "type": "object",
  "required": [
    "schema_version",
    "card_id",
    "character",
    "stream",
    "headline",
    "why_visible",
    "what_changed",
    "compared_with",
    "when_it_matters",
    "affected",
    "evidence_character",
    "source_mode",
    "unknowns",
    "operational_result_id"
  ],
  "properties": {
    "schema_version": {
      "const": "feed-card-v0.1"
    },
    "card_id": {
      "type": "string",
      "pattern": "^feed-card:[0-9a-f]{32}$"
    },
    "character": {
      "const": "DERIVED_VIEW"
    },
    "stream": {
      "enum": [
        "CHANGE_FEED",
        "AUDIT_FEED",
        "ABSTENTION_FEED"
      ]
    },
    "headline": {
      "type": "string",
      "minLength": 1
    },
    "why_visible": {
      "type": "string",
      "minLength": 1
    },
    "what_changed": {
      "type": "string",
      "minLength": 1
    },
    "compared_with": {
      "type": [
        "string",
        "null"
      ]
    },
    "when_it_matters": {
      "type": [
        "string",
        "null"
      ]
    },
    "affected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_character": {
      "enum": [
        "DIRECT",
        "DERIVED",
        "MIXED",
        "SOURCE_ONLY",
        "UNRESOLVED"
      ]
    },
    "source_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closed",
        "refs"
      ],
      "properties": {
        "closed": {
          "type": "boolean"
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "canonical_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "entity_id"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "entity_id": {
            "type": "string"
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "operational_result_id": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
