{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morrow-needle.invalid/schemas/dependency-ripple-composition-v0.1.json",
  "title": "Morrow // Needle Dependency Ripple Composition v0.1",
  "description": "Reference-only composition for Legislative X-Ray cases. Canonical mutation and Change Atom truth stays in owning fixtures.",
  "type": "object",
  "required": [
    "schema_version",
    "analytic_id",
    "composition_character",
    "cases",
    "guardrails"
  ],
  "properties": {
    "schema_version": {
      "const": "dependency-ripple-composition-v0.1"
    },
    "analytic_id": {
      "type": "string",
      "minLength": 1
    },
    "composition_character": {
      "const": "REFERENCE_ONLY"
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "continuity_fixture_path",
          "continuity_object_key",
          "mutation_fixture_path",
          "semantic_fixture_path",
          "atom_id"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "continuity_fixture_path": {
            "type": "string",
            "pattern": "^fixtures/.+\\.json$"
          },
          "continuity_object_key": {
            "type": "string",
            "minLength": 1
          },
          "mutation_fixture_path": {
            "type": "string",
            "pattern": "^fixtures/mutations/.+\\.json$"
          },
          "semantic_fixture_path": {
            "type": "string",
            "pattern": "^fixtures/semantic/.+\\.json$"
          },
          "atom_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "guardrails": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
