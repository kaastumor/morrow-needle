{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morrow-needle.invalid/schemas/source-anomaly-composition-v0.1.json",
  "title": "Morrow // Needle Source Anomaly Composition v0.1",
  "description": "Reference-only specification for a derived view over pinned authoritative-source audit evidence.",
  "type": "object",
  "required": [
    "schema_version",
    "analytic_id",
    "composition_character",
    "evidence_fixture_paths",
    "guardrails"
  ],
  "properties": {
    "schema_version": {
      "const": "source-anomaly-composition-v0.1"
    },
    "analytic_id": {
      "type": "string",
      "minLength": 1
    },
    "composition_character": {
      "const": "REFERENCE_ONLY"
    },
    "evidence_fixture_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^fixtures/audit/.+\\.json$"
      }
    },
    "guardrails": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
