{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morrow-needle.invalid/schemas/retrieval-query-v0.1.json",
  "title": "Morrow // Needle Retrieval Query v0.1",
  "description": "Structured-first query over rebuildable Needle retrieval projections. Empty/omitted filter lists do not constrain results. Non-empty lists are OR within a field and AND across fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "query_id"
  ],
  "properties": {
    "schema_version": {
      "const": "retrieval-query-v0.1"
    },
    "query_id": {
      "type": "string",
      "minLength": 1
    },
    "text_terms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "text_mode": {
      "type": "string",
      "enum": [
        "ALL",
        "ANY"
      ],
      "default": "ALL"
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "THREAD",
              "MUTATION",
              "CHANGE_ATOM",
              "TEMPORAL_ASSERTION",
              "LINEAGE_EDGE",
              "THREAD_EVIDENCE",
              "THREAD_UNKNOWN"
            ]
          }
        },
        "act_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provision_path_prefixes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "languages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        },
        "event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "event_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "legal_effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mutation_operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "temporal_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lineage_scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "STRUCTURAL_LINEAGE",
              "RULE_LINEAGE"
            ]
          }
        },
        "lineage_edge_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification_states": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_states": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_mode_closed": {
          "type": "boolean"
        },
        "identifiers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scheme",
              "value"
            ],
            "properties": {
              "scheme": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "valid_date",
        "perspective",
        "mode"
      ],
      "properties": {
        "dimension": {
          "enum": [
            "PUBLICATION",
            "LEGAL_FORCE",
            "APPLICATION",
            "TEXT_STATE",
            "TRANSITION",
            "DEROGATION",
            "DEADLINE"
          ]
        },
        "valid_date": {
          "type": "string",
          "format": "date"
        },
        "perspective": {
          "enum": [
            "EX_POST_LEGAL_EFFECT",
            "OFFICIAL_SOURCE_STATE_AS_OF"
          ]
        },
        "source_cutoff_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "context": {
          "type": "object"
        },
        "mode": {
          "enum": [
            "ACTIVE_ONLY",
            "EVALUATE"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "perspective": {
                "const": "OFFICIAL_SOURCE_STATE_AS_OF"
              }
            }
          },
          "then": {
            "required": [
              "source_cutoff_date"
            ],
            "properties": {
              "source_cutoff_date": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  }
}
