{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morrow-needle.invalid/schemas/operational-result-v0.1.json",
  "title": "Morrow // Needle Operational Result v0.1",
  "description": "Deterministic process record connecting an official feed event, re-observed source state and downstream legal disposition. This is process state, not a second legal truth store.",
  "type": "object",
  "required": [
    "schema_version",
    "result_id",
    "character",
    "trigger",
    "source_change",
    "disposition",
    "stream",
    "canonical_refs",
    "evidence_refs",
    "unknowns"
  ],
  "properties": {
    "schema_version": {
      "const": "operational-result-v0.1"
    },
    "result_id": {
      "type": "string",
      "pattern": "^operational-result:[0-9a-f]{32}$"
    },
    "character": {
      "const": "PROCESS_RECORD"
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_key",
        "feed_action",
        "ingestion_time",
        "target_cellar_id",
        "root_cellar_id",
        "identifiers",
        "refresh_scope"
      ],
      "properties": {
        "event_key": {
          "type": "string"
        },
        "feed_action": {
          "enum": [
            "CREATE",
            "UPDATE",
            "DELETE"
          ]
        },
        "ingestion_time": {
          "type": "string",
          "format": "date-time"
        },
        "target_cellar_id": {
          "type": "string"
        },
        "root_cellar_id": {
          "type": "string"
        },
        "identifiers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "refresh_scope": {
          "enum": [
            "WORK",
            "EXPRESSION",
            "MANIFESTATION",
            "ITEM_AND_PARENT_MANIFESTATION",
            "TARGET_AND_ROOT"
          ]
        }
      }
    },
    "source_change": {
      "$ref": "source-change-v0.1.schema.json"
    },
    "disposition": {
      "enum": [
        "LEGAL_CHANGE_VERIFIED",
        "LEGAL_NON_IMPACT_VERIFIED",
        "SOURCE_CREATED_UNANALYSED",
        "SOURCE_CONTENT_CHANGED_UNRESOLVED",
        "SOURCE_METADATA_ONLY",
        "SOURCE_AVAILABILITY_CHANGED",
        "NO_MATERIAL_CHANGE",
        "ABSTAIN_SOURCE_UNRESOLVED",
        "ABSTAIN_LEGAL_UNRESOLVED"
      ]
    },
    "stream": {
      "enum": [
        "CHANGE_FEED",
        "AUDIT_FEED",
        "ABSTENTION_FEED"
      ]
    },
    "canonical_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "entity_id"
        ],
        "properties": {
          "kind": {
            "enum": [
              "MUTATION",
              "CHANGE_ATOM",
              "TEMPORAL_ASSERTION",
              "PROCEDURE_STATE",
              "THREAD",
              "THREAD_EVIDENCE",
              "SOURCE_ANOMALY",
              "OTHER"
            ]
          },
          "entity_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "explanation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "what_changed",
        "compared_with",
        "when_it_matters",
        "affected",
        "evidence_character"
      ],
      "properties": {
        "what_changed": {
          "type": "string"
        },
        "compared_with": {
          "type": [
            "string",
            "null"
          ]
        },
        "when_it_matters": {
          "type": [
            "string",
            "null"
          ]
        },
        "affected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_character": {
          "enum": [
            "DIRECT",
            "DERIVED",
            "MIXED",
            "SOURCE_ONLY",
            "UNRESOLVED"
          ]
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
