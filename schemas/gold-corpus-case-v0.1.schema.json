{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morrow-needle.local/schemas/gold-corpus-case-v0.1.schema.json",
  "title": "Morrow Needle Gold Corpus Case v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "title", "adversarial_claim", "language_scope", "official_sources", "expected", "ambiguities", "verification"],
  "properties": {
    "schema_version": {"const": "gold-corpus-case-v0.1"},
    "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "title": {"type": "string", "minLength": 1},
    "adversarial_claim": {"type": "string", "minLength": 1},
    "foundation_contracts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "language_scope": {
      "type": "object", "additionalProperties": false, "required": ["languages", "cross_language_equivalence_assumed"],
      "properties": {"languages": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Z]{3}$"}, "uniqueItems": true}, "cross_language_equivalence_assumed": {"const": false}}
    },
    "official_sources": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "authority", "identifier", "role", "locator"], "properties": {
        "source_id": {"type": "string", "minLength": 1}, "authority": {"enum": ["EUR_LEX", "CELLAR", "OFFICIAL_JOURNAL", "CURIA", "OTHER_OFFICIAL"]},
        "identifier": {"type": "string", "minLength": 1}, "role": {"enum": ["AUTHENTIC_TEXT", "CORRELATION_TABLE", "OFFICIAL_METADATA", "CONSOLIDATED_CHECKPOINT", "PROCEDURAL_RECORD", "OTHER"]},
        "locator": {"type": "string", "minLength": 1}, "observation_ref": {"type": "string"}
      }}
    },
    "expected": {
      "type": "object", "additionalProperties": false, "required": ["document_relationships", "provision_alignments", "textual_mutations", "change_atoms", "non_atoms", "temporal_assertions"],
      "properties": {
        "document_relationships": {"$ref": "#/$defs/assertions"}, "provision_alignments": {"$ref": "#/$defs/assertions"}, "textual_mutations": {"$ref": "#/$defs/assertions"},
        "change_atoms": {"$ref": "#/$defs/assertions"}, "non_atoms": {"$ref": "#/$defs/assertions"}, "temporal_assertions": {"$ref": "#/$defs/assertions"}
      }
    },
    "ambiguities": {"type": "array", "items": {"type": "object", "required": ["description", "retained_as"], "properties": {"description": {"type": "string"}, "retained_as": {"enum": ["UNRESOLVED", "CANDIDATE", "CONFLICT"]}}, "additionalProperties": false},
    "verification": {
      "type": "object", "additionalProperties": false, "required": ["state", "requirements"],
      "properties": {"state": {"enum": ["DRAFT", "EVIDENCED", "VERIFIED"]}, "requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "verified_by": {"type": "array", "items": {"type": "string"}}}
    }
  },
  "$defs": {
    "assertions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["assertion_id", "expectation", "evidence_source_ids", "status"], "properties": {
      "assertion_id": {"type": "string", "minLength": 1}, "expectation": {"type": "string", "minLength": 1}, "evidence_source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "status": {"enum": ["ASSERTED", "CANDIDATE", "UNRESOLVED", "FORBIDDEN_INFERENCE"]}
    }} }
  }
}