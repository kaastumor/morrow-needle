{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morrow-needle.invalid/schemas/source-observation-v0.1.json",
  "title": "Morrow // Needle Source Observation v0.1",
  "description": "Immutable observation of official source bytes. Artifact observations are provenance records and must not be interpreted as legal mutations without normalized legal-text comparison.",
  "type": "object",
  "required": [
    "observation_id",
    "source_system",
    "source_contract",
    "requested_identifier",
    "request",
    "observed_at",
    "response",
    "artifact"
  ],
  "properties": {
    "observation_id": {"type":"string"},
    "source_system": {
      "type":"string",
      "enum":["CELLAR","EUR_LEX","OFFICIAL_JOURNAL","OEIL","COUNCIL","COMMISSION","OTHER_OFFICIAL"]
    },
    "source_contract": {
      "type":"object",
      "required":["adapter","adapter_version","upstream_contract_basis"],
      "properties":{
        "adapter":{"type":"string"},
        "adapter_version":{"type":"string"},
        "upstream_contract_basis":{"type":"string"},
        "contract_checked_at":{"type":["string","null"],"format":"date-time"}
      },
      "additionalProperties":false
    },
    "requested_identifier": {
      "type":"object",
      "required":["scheme","value"],
      "properties":{
        "scheme":{"type":"string"},
        "value":{"type":"string"}
      },
      "additionalProperties":false
    },
    "resolved_identity": {
      "type":["object","null"],
      "properties":{
        "work_id":{"type":["string","null"]},
        "expression_id":{"type":["string","null"]},
        "language":{"type":["string","null"]},
        "manifestation_id":{"type":["string","null"]},
        "manifestation_type":{"type":["string","null"]},
        "item_id":{"type":["string","null"]}
      },
      "additionalProperties":false
    },
    "request": {
      "type":"object",
      "required":["uri","method"],
      "properties":{
        "uri":{"type":"string"},
        "method":{"type":"string","enum":["GET","HEAD"]},
        "accept":{"type":["string","null"]},
        "accept_language":{"type":["string","null"]},
        "query":{"type":"object"}
      },
      "additionalProperties":false
    },
    "observed_at":{"type":"string","format":"date-time"},
    "response": {
      "type":"object",
      "required":["status","final_uri"],
      "properties":{
        "status":{"type":"integer"},
        "content_type":{"type":["string","null"]},
        "final_uri":{"type":"string"},
        "redirect_chain":{
          "type":"array",
          "items":{
            "type":"object",
            "required":["status","uri"],
            "properties":{
              "status":{"type":"integer"},
              "uri":{"type":"string"},
              "location":{"type":["string","null"]}
            },
            "additionalProperties":false
          }
        }
      },
      "additionalProperties":false
    },
    "artifact": {
      "type":"object",
      "required":["byte_length","sha256"],
      "properties":{
        "byte_length":{"type":"integer","minimum":0},
        "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "storage_ref":{"type":["string","null"]},
        "parser_candidate":{"type":"boolean"},
        "render_generation_hint":{"type":["string","null"]}
      },
      "additionalProperties":false
    },
    "legal_mutation_inference":{
      "type":"string",
      "const":"NONE_FROM_ARTIFACT_OBSERVATION_ALONE"
    }
  },
  "additionalProperties":false
}