{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morrow-needle.invalid/schemas/mutation-candidate-v0.3.json",
  "title": "Morrow // Needle Mutation Candidate v0.3",
  "description": "Textual or structural mutation candidate. v0.3 adds explicit authentic-cause-only verification for legally operative amendments observed before consolidated checkpoints catch up.",
  "type": "object",
  "required": [
    "candidate_id",
    "operation",
    "target",
    "alignment_basis",
    "before",
    "after",
    "feature_deltas",
    "reconciliation_state",
    "verification_state",
    "supporting_evidence",
    "conflicting_evidence"
  ],
  "properties": {
    "candidate_id": {
      "type": "string"
    },
    "operation": {
      "type": "string",
      "enum": [
        "INSERT",
        "DELETE",
        "REPLACE",
        "MOVE",
        "RENUMBER",
        "SPLIT",
        "MERGE"
      ]
    },
    "target": {
      "type": "object",
      "required": [
        "kind",
        "citation_path"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "citation_path": {
          "type": "string"
        },
        "parent_citation_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "alignment_basis": {
      "type": "string",
      "enum": [
        "EXACT_CITATION_AND_KIND",
        "SOURCE_NATIVE_IDENTIFIER",
        "ASSERTED_STRUCTURAL_LINEAGE",
        "UNALIGNED",
        "TABLE_COORDINATE"
      ]
    },
    "before": {
      "oneOf": [
        {
          "$ref": "#/$defs/state_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "after": {
      "oneOf": [
        {
          "$ref": "#/$defs/state_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "feature_deltas": {
      "type": "object",
      "required": [
        "numbers_added",
        "numbers_removed",
        "dates_added",
        "dates_removed",
        "references_added",
        "references_removed"
      ],
      "properties": {
        "numbers_added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "numbers_removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dates_added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dates_removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references_added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references_removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "reconciliation_state": {
      "type": "string",
      "enum": [
        "DIFF_ONLY",
        "CORROBORATED",
        "CONFLICTING",
        "QUARANTINED",
        "AUTHENTIC_CAUSE_ONLY"
      ]
    },
    "verification_state": {
      "type": "string",
      "enum": [
        "UNVERIFIED",
        "VERIFIED"
      ]
    },
    "supporting_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_ref"
      }
    },
    "conflicting_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_ref"
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "lineage_edge_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "consumed_candidate_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "structural_alignment": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "source_paths",
            "target_paths"
          ],
          "properties": {
            "source_paths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "target_paths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "comparison_scope": {
      "type": "string",
      "enum": [
        "DIRECT_NODE",
        "SUBTREE",
        "TABLE_CELL"
      ]
    },
    "candidate_origin": {
      "type": "string",
      "enum": [
        "DETERMINISTIC_DIFF",
        "AUTHENTIC_INSTRUCTION",
        "STRUCTURAL_RECLASSIFICATION"
      ]
    }
  },
  "$defs": {
    "state_ref": {
      "type": "object",
      "required": [
        "state_id",
        "node_id",
        "text_hash"
      ],
      "properties": {
        "state_id": {
          "type": "string"
        },
        "node_id": {
          "type": "string"
        },
        "text_hash": {
          "type": "string"
        },
        "text_length": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "evidence_ref": {
      "type": "object",
      "required": [
        "channel",
        "source_id",
        "operation",
        "target_locator",
        "authority_character"
      ],
      "properties": {
        "channel": {
          "type": "string",
          "enum": [
            "AUTHENTIC_ACT",
            "RELATIONSHIP_METADATA",
            "CONSOLIDATION_PROVENANCE",
            "CONSOLIDATED_CHECKPOINT",
            "DETERMINISTIC_DIFF",
            "LINEAGE_EVIDENCE"
          ]
        },
        "source_id": {
          "type": "string"
        },
        "operation": {
          "type": "string",
          "enum": [
            "INSERT",
            "DELETE",
            "REPLACE",
            "MOVE",
            "RENUMBER",
            "SPLIT",
            "MERGE",
            "UNKNOWN"
          ]
        },
        "target_locator": {
          "type": "string"
        },
        "authority_character": {
          "type": "string",
          "enum": [
            "CANONICAL_LEGAL_CAUSE",
            "OFFICIAL_STRUCTURED_METADATA",
            "DOCUMENTARY_NON_BINDING",
            "CHECKPOINT",
            "DERIVED"
          ]
        },
        "locator": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "reconciliation_state": {
            "const": "AUTHENTIC_CAUSE_ONLY"
          }
        },
        "required": [
          "reconciliation_state"
        ]
      },
      "then": {
        "required": [
          "candidate_origin"
        ],
        "properties": {
          "candidate_origin": {
            "const": "AUTHENTIC_INSTRUCTION"
          },
          "operation": {
            "enum": [
              "INSERT",
              "DELETE",
              "REPLACE"
            ]
          },
          "alignment_basis": {
            "const": "SOURCE_NATIVE_IDENTIFIER"
          },
          "before": {
            "type": "null"
          },
          "after": {
            "type": "null"
          },
          "verification_state": {
            "const": "VERIFIED"
          },
          "conflicting_evidence": {
            "maxItems": 0
          },
          "supporting_evidence": {
            "minItems": 1,
            "contains": {
              "type": "object",
              "properties": {
                "channel": {
                  "const": "AUTHENTIC_ACT"
                },
                "authority_character": {
                  "const": "CANONICAL_LEGAL_CAUSE"
                }
              },
              "required": [
                "channel",
                "authority_character"
              ]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "candidate_origin": {
            "const": "AUTHENTIC_INSTRUCTION"
          }
        },
        "required": [
          "candidate_origin"
        ]
      },
      "then": {
        "properties": {
          "alignment_basis": {
            "const": "SOURCE_NATIVE_IDENTIFIER"
          }
        }
      }
    }
  ]
}
