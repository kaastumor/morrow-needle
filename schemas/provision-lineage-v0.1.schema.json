{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morrow-needle.invalid/schemas/provision-lineage-v0.1.json",
  "title": "Morrow // Needle Provision Lineage Edge v0.1",
  "type": "object",
  "required": ["edge_id","edge_type","sources","targets","evidence_basis","evidence_state","source_refs"],
  "properties": {
    "edge_id": {"type":"string"},
    "edge_type": {
      "type":"string",
      "enum":["CONTINUES_AS","RENUMBERED_TO","MOVED_TO","SPLIT_INTO","MERGED_INTO","RECAST_AS","REPLACED_BY","DELETED","INSERTED","CONCEPTUAL_SUCCESSOR"]
    },
    "sources": {
      "type":"array",
      "items":{"$ref":"#/$defs/provision_instance_ref"}
    },
    "targets": {
      "type":"array",
      "items":{"$ref":"#/$defs/provision_instance_ref"}
    },
    "evidence_basis": {
      "type":"array",
      "minItems":1,
      "uniqueItems":true,
      "items":{
        "type":"string",
        "enum":["OFFICIAL_CORRELATION_TABLE","OFFICIAL_AMENDMENT_INSTRUCTION","OFFICIAL_RELATION_METADATA","DETERMINISTIC_TEXT_ALIGNMENT","OFFICIAL_EXPLANATORY_MATERIAL","HUMAN_LEGAL_REVIEW","MODEL_HYPOTHESIS"]
      }
    },
    "evidence_state": {
      "type":"string",
      "enum":["DIRECT","DERIVED","CONTEXTUAL","ATTRIBUTED","INTERPRETIVE","UNRESOLVED"]
    },
    "source_refs": {
      "type":"array",
      "minItems":1,
      "items":{
        "type":"object",
        "required":["source_type","identifier","role"],
        "properties":{
          "source_type":{"type":"string","enum":["OJ","EUR_LEX","CELLAR","ELI","OTHER_OFFICIAL"]},
          "identifier":{"type":"string"},
          "locator":{"type":["string","null"]},
          "role":{"type":"string","enum":["LINEAGE_EVIDENCE","SOURCE_TEXT","TARGET_TEXT","STATUS"]}
        },
        "additionalProperties":false
      }
    },
    "notes":{"type":["string","null"]}
  },
  "$defs": {
    "provision_instance_ref": {
      "type":"object",
      "required":["act_id","structural_path"],
      "properties":{
        "act_id":{"type":"string"},
        "eli":{"type":["string","null"]},
        "version":{"type":["string","null"]},
        "language":{"type":["string","null"]},
        "structural_path":{"type":"string"},
        "text_hash":{"type":["string","null"]}
      },
      "additionalProperties":false
    }
  },
  "additionalProperties":false
}