{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morrow-needle.invalid/schemas/authoritative-finding-v0.1.json",
  "title": "Morrow // Needle Authoritative Finding v0.1",
  "description": "Canonical direct categorical determination by a legally relevant authority or official control system. It owns finding truth, not downstream legal consequences, spatial derivation or temporal application.",
  "type": "object",
  "required": [
    "schema_version",
    "finding_id",
    "character",
    "finding_type",
    "authority",
    "subject_ref",
    "finding_date",
    "proposition",
    "evidence_state",
    "source_refs",
    "legal_relevance",
    "forbidden_inferences"
  ],
  "properties": {
    "schema_version": {"const": "authoritative-finding-v0.1"},
    "finding_id": {"type": "string", "minLength": 1},
    "character": {"const": "AUTHORITATIVE_FINDING"},
    "finding_type": {
      "type": "string",
      "enum": [
        "SCIENTIFIC_CONFIRMATION",
        "INSPECTION_DETERMINATION",
        "OFFICIAL_CLASSIFICATION",
        "OTHER_OFFICIAL_DETERMINATION"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_id", "label", "authority_type"],
      "properties": {
        "authority_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "authority_type": {
          "type": "string",
          "enum": [
            "EU_INSTITUTION",
            "EU_AGENCY",
            "MEMBER_STATE_AUTHORITY",
            "OFFICIAL_CONTROL_SYSTEM",
            "OTHER_OFFICIAL_AUTHORITY"
          ]
        }
      }
    },
    "subject_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identifier", "label"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "identifier": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1}
      }
    },
    "location_ref": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["label"],
          "properties": {
            "label": {"type": "string", "minLength": 1},
            "coordinate_system": {"type": ["string", "null"]},
            "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
            "longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
            "location_character": {"type": ["string", "null"]}
          }
        },
        {"type": "null"}
      ]
    },
    "finding_date": {
      "type": "string",
      "format": "date"
    },
    "proposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "statement", "polarity"],
      "properties": {
        "category": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "polarity": {
          "type": "string",
          "enum": ["AFFIRMED", "NEGATED", "UNRESOLVED"]
        }
      }
    },
    "evidence_state": {"const": "DIRECT"},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source_ref"}
    },
    "legal_relevance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "rule_refs"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "rule_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source_ref"}
        }
      }
    },
    "forbidden_inferences": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "notes": {"type": ["string", "null"]}
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "identifier",
        "locator",
        "role",
        "authority_character"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "EUR_LEX",
            "OFFICIAL_JOURNAL",
            "COMMISSION",
            "MEMBER_STATE_OFFICIAL",
            "OTHER_OFFICIAL"
          ]
        },
        "identifier": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "language": {"type": ["string", "null"]},
        "role": {
          "type": "string",
          "enum": [
            "FINDING",
            "SUBJECT_IDENTITY",
            "LOCATION",
            "LEGAL_RELEVANCE",
            "CONTEXT"
          ]
        },
        "authority_character": {
          "type": "string",
          "enum": [
            "BINDING_LEGAL_TEXT",
            "AUTHENTIC_OFFICIAL_FINDING",
            "OFFICIAL_CONTEXT"
          ]
        }
      }
    }
  },
  "additionalProperties": false
}
