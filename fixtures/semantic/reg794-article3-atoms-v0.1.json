  "source_span_registry": {
    "span-sani-duty": {
      "identifier": "CELEX:32008R0271",
      "language": "ENG",
      "text": "As from 1 July 2008, notifications shall be transmitted electronically via the web application State Aid Notification Interactive (SANI).",
      "text_hash": "e4be9c1a527f6ef3ec8f4214aae06b58d86477e015651327e71ca83d45aa3d8a",
      "locator": "L_2008082EN.01000101.xml#normalized-chars:7414-7551",
