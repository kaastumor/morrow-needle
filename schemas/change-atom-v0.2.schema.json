{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morrow-needle.invalid/schemas/change-atom-v0.2.json",
  "title": "Morrow // Needle Change Atom v0.2",
  "description": "Historical stress-tested draft. Superseded because its legal_state.force_state collapsed orthogonal P0-E/P0-H dimensions.",
  "type": "object",
  "required": [
    "atom_id",
    "legal_effect",
    "dimensions",
    "textual_operations",
    "comparator",
    "legal_state",
    "evidence_state",
    "source_refs",
    "provenance"
  ],
  "properties": {
    "atom_id": {
      "type": "string"
    },
    "dossier_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "act_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "provision_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "subject": {
      "type": [
        "string",
        "null"
      ]
    },
    "legal_effect": {
      "type": "string",
      "enum": [
        "DUTY",
        "RIGHT",
        "PROHIBITION",
        "PERMISSION",
        "POWER",
        "REMEDY",
        "DEFINITION",
        "LEGAL_STATUS",
        "NONE"
      ]
    },
    "dimensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "PROCEDURE",
          "SCOPE",
          "EXCEPTION",
          "DEROGATION",
          "TIME",
          "DEADLINE",
          "TRANSITION",
          "MONEY",
          "THRESHOLD",
          "REPORTING",
          "ENFORCEMENT",
          "SUPERVISION",
          "DELEGATION",
          "DIGITAL_CHANNEL",
          "ANNEX",
          "CLASSIFICATION",
          "CROSS_REFERENCE",
          "VALIDITY_CONDITION",
          "IDENTIFIER",
          "OTHER"
        ]
      }
    },
    "textual_operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "INSERT",
          "DELETE",
          "REPLACE",
          "MOVE",
          "RENUMBER",
          "SPLIT",
          "MERGE",
          "CORRECT",
          "REPEAL",
          "REVIVE",
          "EXTEND",
          "ANNEX_REPLACE",
          "CROSS_REFERENCE_UPDATE"
        ]
      }
    },
    "before_state": {
      "type": [
        "object",
        "null"
      ]
    },
    "after_state": {
      "type": [
        "object",
        "null"
      ]
    },
    "comparator": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "PREVIOUS_LEGAL_STATE",
            "PREVIOUS_DRAFT",
            "COMMISSION_PROPOSAL",
            "PARLIAMENT_POSITION",
            "COUNCIL_POSITION",
            "CONSOLIDATED_CHECKPOINT",
            "OTHER"
          ]
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "legal_state": {
      "type": "object",
      "required": [
        "force_state"
      ],
      "properties": {
        "procedure_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "force_state": {
          "type": "string",
          "enum": [
            "NOT_ADOPTED",
            "ADOPTED_NOT_PUBLISHED",
            "PUBLISHED_NOT_IN_FORCE",
            "IN_FORCE_NOT_APPLICABLE",
            "APPLICABLE",
            "PARTIALLY_APPLICABLE",
            "EXPIRED",
            "REPEALED",
            "PARTIALLY_REPEALED",
            "UNKNOWN"
          ]
        }
      },
      "additionalProperties": false
    },
    "temporal_effect": {
      "type": "object",
      "properties": {
        "source_document_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "source_publication_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "source_entry_into_force": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "text_state_valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "text_state_valid_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "rule_application_start": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "rule_application_end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "date_derivation": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "EXPLICIT_SOURCE",
            "OFFICIAL_RELATION_METADATA",
            "DERIVED",
            "UNKNOWN"
          ]
        }
      },
      "additionalProperties": false
    },
    "affected_entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "basis"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "basis": {
            "type": "string",
            "enum": [
              "DIRECT",
              "DERIVED",
              "CONTEXTUAL",
              "ATTRIBUTED",
              "INTERPRETIVE",
              "UNRESOLVED"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_state": {
      "type": "string",
      "enum": [
        "DIRECT",
        "DERIVED",
        "CONTEXTUAL",
        "ATTRIBUTED",
        "INTERPRETIVE",
        "UNRESOLVED"
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_type",
          "identifier",
          "role"
        ],
        "properties": {
          "source_type": {
            "type": "string",
            "enum": [
              "OJ",
              "EUR_LEX",
              "CELLAR",
              "ELI",
              "OEIL",
              "COUNCIL",
              "COMMISSION",
              "OTHER_OFFICIAL"
            ]
          },
          "identifier": {
            "type": "string"
          },
          "locator": {
            "type": [
              "string",
              "null"
            ]
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "CAUSE",
              "BEFORE",
              "AFTER",
              "CORROBORATION",
              "CONTEXT",
              "STATUS",
              "TEMPORAL"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "observed_at"
      ],
      "properties": {
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "raw_artifact_hashes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extractor_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "verifier_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "human_review": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "$comment": "RETAINED PRECURSOR. Superseded by change-atom-v0.3. v0.2 collapses procedure/publication/force/application state and must not be extended."
}