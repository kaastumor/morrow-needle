{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morrow-needle.invalid/schemas/half-life-view-v0.1.json",
  "title": "Morrow // Needle Half-Life Derived View v0.1",
  "description": "Disposable analytic projection over canonical Temporal Assertions and regime genealogy.",
  "type": "object",
  "required": [
    "schema_version",
    "analytic_id",
    "topic",
    "character",
    "sources",
    "coverage",
    "genealogy",
    "original_plan",
    "extensions",
    "episodes",
    "gaps",
    "summary",
    "guardrails",
    "unknowns"
  ],
  "properties": {
    "schema_version": {
      "const": "half-life-view-v0.1"
    },
    "analytic_id": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "character": {
      "const": "DERIVED_VIEW"
    },
    "sources": {
      "type": "object",
      "required": [
        "temporal_assertion_ids",
        "regime_lineage_edge_ids"
      ],
      "properties": {
        "temporal_assertion_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "regime_lineage_edge_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "original_plan": {
      "$ref": "#/$defs/interval"
    },
    "extensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/extension"
      }
    },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/episode"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap"
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "original_planned_days",
        "first_regime_actual_days",
        "extension_added_days",
        "successor_days",
        "total_applicable_days",
        "calendar_span_days",
        "non_applicable_days",
        "first_regime_duration_ratio"
      ],
      "properties": {
        "original_planned_days": {
          "type": "integer",
          "minimum": 1
        },
        "first_regime_actual_days": {
          "type": "integer",
          "minimum": 1
        },
        "extension_added_days": {
          "type": "integer",
          "minimum": 0
        },
        "successor_days": {
          "type": "integer",
          "minimum": 0
        },
        "total_applicable_days": {
          "type": "integer",
          "minimum": 1
        },
        "calendar_span_days": {
          "type": "integer",
          "minimum": 1
        },
        "non_applicable_days": {
          "type": "integer",
          "minimum": 0
        },
        "first_regime_duration_ratio": {
          "type": "number",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "guardrails": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "genealogy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "relation_type",
        "evidence_state",
        "source_regime_ids",
        "target_regime_ids"
      ],
      "properties": {
        "edge_id": {
          "type": "string"
        },
        "relation_type": {
          "type": "string"
        },
        "evidence_state": {
          "type": "string"
        },
        "source_regime_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "target_regime_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_continuity",
        "terminal_outcome",
        "view_horizon"
      ],
      "properties": {
        "rule_continuity": {
          "const": "NOT_ASSERTED"
        },
        "terminal_outcome": {
          "const": "UNRESOLVED_AFTER_VIEW_HORIZON"
        },
        "view_horizon": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "regime_id",
            "boundary"
          ],
          "properties": {
            "regime_id": {
              "type": "string"
            },
            "boundary": {
              "$ref": "#/$defs/boundary"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "boundary": {
      "type": "object",
      "required": [
        "date",
        "assertion_id",
        "inclusive",
        "resolution_state",
        "evidence_state",
        "source_refs"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "assertion_id": {
          "type": "string"
        },
        "inclusive": {
          "type": "boolean"
        },
        "resolution_state": {
          "type": "string"
        },
        "evidence_state": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "source_type",
              "identifier",
              "role"
            ],
            "properties": {
              "source_type": {
                "type": "string"
              },
              "identifier": {
                "type": "string"
              },
              "locator": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "language": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "role": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "interval": {
      "type": "object",
      "required": [
        "regime_id",
        "start",
        "end",
        "duration_days"
      ],
      "properties": {
        "regime_id": {
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/boundary"
        },
        "end": {
          "$ref": "#/$defs/boundary"
        },
        "duration_days": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "extension": {
      "type": "object",
      "required": [
        "regime_id",
        "previous_end",
        "new_end",
        "added_days",
        "supersedes_assertion_id",
        "extension_assertion_id"
      ],
      "properties": {
        "regime_id": {
          "type": "string"
        },
        "previous_end": {
          "type": "string",
          "format": "date"
        },
        "new_end": {
          "type": "string",
          "format": "date"
        },
        "added_days": {
          "type": "integer",
          "minimum": 1
        },
        "supersedes_assertion_id": {
          "type": "string"
        },
        "extension_assertion_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "episode": {
      "allOf": [
        {
          "$ref": "#/$defs/interval"
        }
      ]
    },
    "gap": {
      "type": "object",
      "required": [
        "from_regime_id",
        "to_regime_id",
        "start",
        "end",
        "duration_days",
        "previous_end_assertion_id",
        "next_start_assertion_id"
      ],
      "properties": {
        "from_regime_id": {
          "type": "string"
        },
        "to_regime_id": {
          "type": "string"
        },
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        },
        "duration_days": {
          "type": "integer",
          "minimum": 1
        },
        "previous_end_assertion_id": {
          "type": "string"
        },
        "next_start_assertion_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
